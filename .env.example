# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (leave empty to run in read-only demo mode with fabricated seed data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for event ingestion, ownership verification,
# quality checks and rate limits. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Search engines ---
# Keep unset (or "false") until launch: the whole site is then noindex and robots.txt disallows everything.
ALLOW_INDEXING=false

# --- Moderation ---
# When "true", new submissions are created as `pending` until an admin approves them.
SUBMIT_REQUIRES_APPROVAL=false

# --- Cron (Vercel Cron sends this as a Bearer token) ---
CRON_SECRET=
