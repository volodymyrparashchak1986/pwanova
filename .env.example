# ---------------------------------------------------------------------------
# PWANova environment. Copy to .env.local (gitignored).
#
# LOCAL FIRST: .env.local points at the LOCAL Supabase stack started with
# `supabase start` (this repository uses ports 55320-55329). Take the local
# API URL and the local anon / service_role keys from `supabase status`.
# Production credentials never belong in .env.local: `npm run dev`,
# `npm run verify:supabase` and `npm run import:apps` write to whatever this
# file points at.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY: shared rate limits, events, ownership and technical observations.
SUPABASE_SERVICE_ROLE_KEY=

# Explicit demonstration only. Production with missing credentials shows no fabricated catalog.
DEMO_MODE=false
SHOW_DEMO_DATA=false
# Private pilot: indexing is opt-in; noindex is not access control.
ALLOW_INDEXING=false

# Enable only after configuring and testing the corresponding Supabase OAuth provider.
NEXT_PUBLIC_AUTH_GOOGLE=false
NEXT_PUBLIC_AUTH_GITHUB=false
# Optional authenticated maintenance route; raw events retained for 180 days.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Cloud (production) diagnostics are the exception, not the default:
# keep them in a file that nothing loads automatically (for example
# .env.cloud-diagnostics, gitignored) and pass it explicitly:
#   node --env-file=.env.cloud-diagnostics --import tsx scripts/<script>.ts
# Writing scripts additionally require, for that one run:
#   ALLOW_PRODUCTION_TARGET=<project_ref>
# ---------------------------------------------------------------------------
