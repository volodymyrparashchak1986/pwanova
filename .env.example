# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (leave empty to run in read-only demo mode with fabricated seed data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for event ingestion, ownership verification,
# quality checks and rate limits. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Search engines ---
# Keep unset (or "false") until launch: the whole site is then noindex and robots.txt disallows everything.
ALLOW_INDEXING=false

# --- Demo data isolation ---
# Server-only (no NEXT_PUBLIC_ prefix): keep "false" on any environment that might have real users.
# When false, fabricated is_demo rows (from supabase/seed.sql) are excluded from every listing, search,
# ranking, sitemap and the public partner API -- even if they're still sitting in the database. A demo
# app's own page/embed/badge stays reachable by direct link (clearly labelled "Demo data") so the
# Partner Kit's worked example at /partners/demo keeps working. See docs/beta-audit.md.
SHOW_DEMO_DATA=false

# --- Moderation ---
# When "true", new submissions are created as `pending` until an admin approves them.
SUBMIT_REQUIRES_APPROVAL=false

# --- Cron (Vercel Cron sends this as a Bearer token) ---
CRON_SECRET=
